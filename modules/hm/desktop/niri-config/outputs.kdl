// ============ 输出(显示器)配置 ============
// 默认 niri 会用所有显示器的首选分辨率自动点亮;
// 用 output 段落可以关闭或调整单个显示器。
// 匹配方式:连接器名(eDP-1 / HDMI-A-1)或「厂商 型号 序列号」,
// 可用 `niri msg outputs` 查看全部信息。
// 你的笔记本内屏一般是 eDP-1,外接显示器插 HDMI。

output "Virtual-1" {
    // 完全关闭该显示器
    // off

    // 分辨率@刷新率,格式 "宽x高" 或 "宽x高@刷新率"。
    // 省略刷新率则用该分辨率下最高刷新率;省略整个 mode 则自动选。
    // 刷新率必须和 `niri msg outputs` 里显示的三位小数完全一致!
    // 例:mode "1920x1080@60.000"
    mode "1920x1080@60.000"

    // 自定义模式(25.11+),显示器不支持的参数,强制刷新率必须写。
    // 有烧屏风险,不推荐
    // mode custom=true "1920x1080@100"

    // 用 modeline 直接指定模式(25.11+),覆盖上面的 mode。
    // 用 cvt / gtf 命令计算,同样有风险,不推荐
    // modeline 173.00  1920 2048 2248 2576  1080 1083 1088 1120 "-hsync" "+vsync"

    // 缩放倍率。不写时按物理尺寸+分辨率自动猜。
    // 支持小数(0.1.7+)。你的屏是 15.6 寸 1080p,1.5 倍字体比较舒服
    scale 1.5

    // 逆时针旋转输出:"normal"/"90"/"180"/"270"/"flipped"/"flipped-90"/"flipped-180"/"flipped-270"
    // (flipped 前缀表示镜像翻转,竖屏显示器配 "90" 用)
    // transform "normal"

    // 在全局坐标系中的位置,决定 monitor 方向键、鼠标跨界。
    // 注意用的是缩放后的逻辑像素:3840x2160@scale2 = 逻辑 1920x1080,
    // 右边显示器要从 x=1920 开始放。
    // 不写或重叠时自动摆放(按名字排序,把没配置的往右排)
    // position x=1920 y=0
    position x=0 y=0


    // 可变刷新率 VRR(FreeSync/G-Sync),显示器支持才生效。
    // 部分驱动有毛病;觉得鼠标卡顿可以试 debug 里的 disable-cursor-plane
    // variable-refresh-rate
    // 按需开启(0.1.9+):只有显示匹配 variable-refresh-rate 窗口规则的
    // 窗口时才启用 VRR,避免日常小问题,推荐配合游戏窗口规则用
    // variable-refresh-rate on-demand=true

    // niri 启动时默认聚焦这个显示器;多个声明按配置顺序优先。
    // 你的笔记本内屏,保持默认即可
    // focus-at-startup


    // 最大每通道位数 6/8/10/12/14/16。
    // 正常不需要动!只有遇到带宽不足(某些分辨率+刷新率组合设置不上)
    // 才调低,平时让驱动自动
    // max-bpc 8

    // 热角(25.11+):鼠标到这个显示器的角落就开关概览。
    // 不写则用 gestures 里的全局热角设置;
    // off 关闭本显示器的热角;写哪些就只开哪些
    // hot-corners {
    //     // off
    //     top-left
    //     // top-right
    //     // bottom-left
    //     // bottom-right
    // }

}

// 外接显示器示例(接到 HDMI 时按需取消注释,名字用 niri msg outputs 查)
// output "HDMI-A-1" {
//     mode "1920x1080@120.000"  // 高刷屏记得手动指定,默认偏好常是 60Hz
//     position x=1920 y=0       // 放在内屏右侧,逻辑像素,考虑内屏 scale
//     variable-refresh-rate     // 游戏/观影屏开 VRR
//     focus-at-startup          // 想优先聚焦外接屏就开
// }

// 想关掉的屏直接:
// output "HDMI-A-1" {
//     off
// }
