layout {

    focus-ring {
        active-color   "#b8cac9"
        inactive-color "#131313"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#b8cac9"
        inactive-color "#131313"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#b8cac9"
        inactive-color "#829493"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#b8cac980"
    }
}

recent-windows {
    highlight {
        active-color "#b8cac9"
        urgent-color "#ffb4ab"
    }
}
